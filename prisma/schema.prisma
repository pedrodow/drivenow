// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
  reservations Reservation[]
  resetTokens  PasswordResetToken[]
}

// Só guardamos o que a reserva precisa. Dados de pagamento NUNCA chegam ao
// servidor (o checkout é demonstração). Datas são "YYYY-MM-DD" em texto para
// não sofrerem com fuso horário; `total` é recalculado no servidor.
model Reservation {
  id             String   @id @default(cuid())
  reference      String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleSlug    String
  vehicleName    String
  pickupLocation String
  returnLocation String
  pickupDate     String
  returnDate     String
  days           Int
  protectionPlan String
  extras         String   @default("[]") // JSON: ids dos extras escolhidos
  total          Int
  status         String   @default("confirmed") // confirmed | cancelled
  createdAt      DateTime @default(now())

  @@index([userId])
}

// O id da sessão É o token da sessão (gerado com crypto.randomBytes em
// lib/auth/session.ts) — evita manter um campo de token separado.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Contador genérico para limitar tentativas (login, cadastro, recuperação de
// senha). Fica no banco porque na Vercel cada execução é isolada: não existe
// memória compartilhada entre requisições. `key` = "<ação>:<email|ip>:<valor>".
model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Link de "esqueci minha senha". Guardamos só o HASH (sha256) do token: se o banco
// vazar, ninguém consegue usar os links. O token em si só existe no e-mail.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
