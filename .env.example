# Copie este arquivo para `.env` e ajuste os valores.

# Desenvolvimento local: arquivo SQLite (relativo à raiz do projeto).
DATABASE_URL="file:./prisma/dev.db"

# Produção (Vercel + Turso) — será usado na fase do banco remoto:
# DATABASE_URL="libsql://<seu-banco>.turso.io"
# DATABASE_AUTH_TOKEN="<token-do-turso>"

# Opcional: URL pública do site (sitemap, robots, metadados). Na Vercel não precisa
# definir — o domínio de produção é detectado sozinho. Só use com domínio próprio.
# NEXT_PUBLIC_SITE_URL="https://meudominio.com.br"

# Recuperação de senha (e-mail via Resend — resend.com, plano gratuito).
# Sem RESEND_API_KEY, em desenvolvimento o link aparece no terminal em vez de ser enviado.
# RESEND_API_KEY="re_..."
# Sem domínio próprio verificado, use o remetente de teste (só entrega ao dono da conta Resend):
# RESEND_FROM="DriveNow <onboarding@resend.dev>"
